          "expr": "100 * (sum(rate(http_requests_total{service=\"helium\",status_code=~\"4..|5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{service=\"helium\"}[5m])), 1e-9)",
          "legendFormat": "errors %",
