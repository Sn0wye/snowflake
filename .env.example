# Copy this file to .env and fill in values for local Docker Compose testing.
# .env is gitignored. For production, set these via Coolify's environment variables UI.

# =============================================================================
# Data Persistence Paths (VPS/Docker host directories)
# =============================================================================
POSTGRES_DATA_PATH=/data/snowflake/postgres
RABBITMQ_DATA_PATH=/data/snowflake/rabbitmq

# =============================================================================
# HELIUM (Authentication Service — Go)
# DATABASE_URL format: postgres://user:pass@host:5432/db?sslmode=disable
# =============================================================================
HELIUM_DATABASE_URL=postgres://snowflake:snowflake@postgres:5432/helium?sslmode=disable
HELIUM_RABBITMQ_URL=amqp://snowflake:snowflake@rabbitmq:5672
HELIUM_JWT_SECRET=change-me-in-production
HELIUM_JWT_ISSUER=snowflake
# HELIUM_HTTP_PORT=8080
# HELIUM_GRPC_PORT=50050
# HELIUM_LOG_LEVEL=info
HELIUM_LOG_ENCODING=json
HELIUM_ENV=production
HELIUM_LOG_FILE_NAME=

# =============================================================================
# GOLD (Payment & Balance Service — Go)
# DATABASE_URL format: postgres://user:pass@host:5432/db?sslmode=disable
# =============================================================================
GOLD_DATABASE_URL=postgres://snowflake:snowflake@postgres:5432/gold?sslmode=disable
GOLD_RABBITMQ_URL=amqp://snowflake:snowflake@rabbitmq:5672
GOLD_JWT_SECRET=change-me-in-production
GOLD_JWT_ISSUER=snowflake
# GOLD_HTTP_PORT=8083
# GOLD_GRPC_PORT=50053
# GOLD_LOG_LEVEL=info
GOLD_LOG_ENCODING=json
GOLD_ENV=production
GOLD_LOG_FILE_NAME=

# =============================================================================
# CARBON (Scorer Service — Spring Boot)
# DATABASE_URL format: jdbc:postgresql://host:5432/db  (JDBC format, not postgres://)
# =============================================================================
CARBON_DATABASE_URL=jdbc:postgresql://postgres:5432/carbon
CARBON_RABBITMQ_HOST=rabbitmq
# CARBON_GRPC_HOST=snowflake-helium
# CARBON_HTTP_PORT=8081
# CARBON_LOG_LEVEL=INFO
# SPRING_PROFILES_ACTIVE is hardcoded to "production" in docker-compose — do not override unless intentional

# =============================================================================
# OXYGEN (Loan Service — .NET)
# DATABASE_URL format: Host=host;Database=db;Username=user;Password=pass  (Npgsql format)
# =============================================================================
OXYGEN_DATABASE_URL=Host=postgres;Database=oxygen;Username=snowflake;Password=snowflake
OXYGEN_GRPC_URL=http://snowflake-helium:50050
OXYGEN_JWT_SECRET=change-me-in-production
# OXYGEN_HTTP_PORT=8082
# OXYGEN_LOG_LEVEL=Information
OXYGEN_ENVIRONMENT=Production
